# Configuración del backend para arrancarlo sin Docker («bare metal»), con los mismos
# valores que el servicio `backend` de docker-compose.yml.
#
#   cp backend/.env.example backend/.env
#
# La aplicación (npm run start / start:dev) y las migraciones (npm run migration:run)
# leen backend/.env desde el directorio backend/. Las variables definidas en la shell
# tienen prioridad sobre las del fichero.

# Base de datos: mysql en desarrollo y producción (sqljs sólo se usa en los tests).
DB_TYPE=mysql

# MySQL 8.4 con la base `rota` y el usuario `rota_user`, como el servicio `db` de Docker.
# Con `docker compose up -d db` vale tal cual. En Docker el host es `db`; aquí, `localhost`.
# Con un MySQL propio, créelos antes:
#   CREATE DATABASE rota CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_as_cs;
#   CREATE USER 'rota_user'@'localhost' IDENTIFIED BY 'rota_pass';
#   GRANT ALL PRIVILEGES ON rota.* TO 'rota_user'@'localhost';
DATABASE_URL=mysql://rota_user:rota_pass@localhost:3306/rota

# API de festivos españoles.
HOLIDAY_API_URL=https://date.nager.at/api/v3

# Ciudad del hospital: decide los festivos regionales (Alicante → Comunitat Valenciana).
CITY=Alicante

# Puerto HTTP del backend. El frontend (`ng serve` con src/proxy.conf.json) espera el 8000.
PORT=8000
